# Copy this file to /opt/nihongo-app/.env on the VPS and fill in the values.
# Never commit the real .env (it is already in .gitignore).

# Image pushed by GitHub Actions. ghcr.io needs a LOWERCASE path: <github-user>/<repo>/backend
BACKEND_IMAGE=ghcr.io/minhlee102/nihonmukae/backend:latest

# Domain that points at the VPS (A record). Leave as ":80" to serve plain HTTP by IP (testing only).
API_DOMAIN=api.example.com

# Exact origin of the frontend on Vercel (no trailing slash)
CORS_ALLOWED_ORIGIN=https://app.example.com

# true when API_DOMAIN is served over HTTPS. Set false only when testing over plain HTTP.
APP_COOKIE_SECURE=true

POSTGRES_DB=nihon_mukae
POSTGRES_USER=nihon
# Generate with:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# At least 32 characters. Generate with:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# JVM memory. Leave unset on a VM with 2 GiB or more. On a 1 GiB VM (Azure B1s and similar) use a fixed cap
# (measured: about 515 MB for the backend container with this setting under light load):
# JAVA_OPTS=-Xms128m -Xmx384m -XX:+UseSerialGC -XX:MaxMetaspaceSize=160m
